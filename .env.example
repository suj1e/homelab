COMPOSE_PROJECT_NAME=homelab

# Public DNS zone used by Caddy. Create A/AAAA records for each subdomain.
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com
TZ=Asia/Shanghai

# Homepage
HOMEPAGE_ALLOWED_HOSTS=home.example.com

# n8n
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
# Generate once and keep it stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-stable-key

# Beszel: fill these after adding the local system in the Beszel UI.
BESZEL_AGENT_TOKEN=replace-after-creating-beszel-system
BESZEL_AGENT_KEY=replace-after-creating-beszel-system
